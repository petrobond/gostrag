# --- GigaChat ---
GIGACHAT_CREDENTIALS=replace_me
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_MODEL_ULTRA=GigaChat-3-Ultra
GIGACHAT_MODEL_MAX=GigaChat-2-Max
GIGACHAT_MODEL_PRO=GigaChat-2-Pro
GIGACHAT_MODEL_LITE=GigaChat-2
GIGACHAT_EMBEDDING_MODEL=GigaEmbeddings-3B-2025-09
GIGACHAT_EMBEDDING_DIM=2048
EMBEDDING_PROVIDER=local
EMBEDDING_CACHE_DIR=
EMBEDDING_THREADS=8

# --- Fallback: Yandex AI Studio (DeepSeek) ---
YC_FOLDER_ID=replace_me
YC_API_KEY=replace_me
YC_MODEL=deepseek-v4.1-flash/latest
YC_BASE_URL=https://ai.api.cloud.yandex.net/v1

# --- Fallback: direct DeepSeek ---
DEEPSEEK_API_KEY=replace_me
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# --- S3 / Object Storage (source PDFs) ---
S3_ENDPOINT=https://storage.yandexcloud.net
S3_BUCKET=replace_me
S3_ACCESS_KEY=replace_me
S3_SECRET_KEY=replace_me
S3_REGION=ru-central1
S3_PREFIX=gost/

# --- Telegram ---
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_USER_IDS=0
TELEGRAM_ADMIN_IDS=0

# --- Infra ---
POSTGRES_DSN=postgresql://gostrag:gostrag@postgres:5432/gostrag
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=gost_chunks

# --- Limits ---
DAILY_QUESTIONS_PER_USER=50
HOURLY_QUESTIONS_PER_USER=10
DAILY_TOKENS_GLOBAL=2000000
MAX_TOP_K=10
REQUEST_TIMEOUT_SEC=90
QUEUE_MAX_DEPTH=5

# --- App ---
APP_VERSION=0.1.0
CORPUS_VERSION=2026.11.11
DATA_SOURCE_DIR=/data/source
DATA_CORPUS_DIR=/data/corpus
INDEX_DIR=/data/index
REPORTS_DIR=/app/reports
LOG_LEVEL=INFO
