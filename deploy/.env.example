# --- GigaChat ---
GIGACHAT_CREDENTIALS=replace_me
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
# bundle with Russian Trusted Root/Sub CA; empty -> certifi/system default
GIGACHAT_CA_BUNDLE=
GIGACHAT_MODEL_ULTRA=GigaChat-3-Ultra
GIGACHAT_MODEL_MAX=GigaChat-2-Max
GIGACHAT_MODEL_PRO=GigaChat-2-Pro
GIGACHAT_MODEL_LITE=GigaChat-2
GIGACHAT_EMBEDDING_MODEL=GigaEmbeddings-3B-2025-09
GIGACHAT_EMBEDDING_DIM=2048
EMBEDDING_PROVIDER=cloudru
# local fallback: pip install -e '.[local]' (fastembed/ONNX)
EMBEDDING_CACHE_DIR=
EMBEDDING_THREADS=8

# --- Cloud.ru Foundation Models embeddings (EMBEDDING_PROVIDER=cloudru) ---
CLOUDRU_API_KEY=replace_me
CLOUDRU_BASE_URL=https://foundation-models.api.cloud.ru/v1
CLOUDRU_EMBEDDING_MODEL=BAAI/bge-m3
CLOUDRU_EMBEDDING_DIM=1024
CLOUDRU_BATCH_SIZE=16
CLOUDRU_TIMEOUT_SEC=60
CLOUDRU_MAX_RETRIES=3

# --- Reranker (optional; A/B показал ухудшение recall — по умолчанию off) ---
RERANK_ENABLED=false
CLOUDRU_RERANK_URL=https://foundation-models.api.cloud.ru/score
CLOUDRU_RERANK_MODEL=BAAI/bge-reranker-v2-m3
CLOUDRU_RERANK_TIMEOUT_SEC=60
RERANK_TOP_N=20

# --- Fallback: Yandex AI Studio (DeepSeek) ---
YC_FOLDER_ID=replace_me
YC_API_KEY=replace_me
YC_MODEL=deepseek-v4.1-flash/latest
YC_BASE_URL=https://ai.api.cloud.yandex.net/v1

# --- Fallback: direct DeepSeek ---
DEEPSEEK_API_KEY=replace_me
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# --- S3 / Object Storage (source PDFs) ---
S3_ENDPOINT=https://storage.yandexcloud.net
S3_BUCKET=replace_me
S3_ACCESS_KEY=replace_me
S3_SECRET_KEY=replace_me
S3_REGION=ru-central1
S3_PREFIX=gost/

# --- Telegram ---
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_USER_IDS=0
TELEGRAM_ADMIN_IDS=0

# --- Infra ---
POSTGRES_DSN=postgresql://gostrag:gostrag@postgres:5432/gostrag
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=gost_chunks_bge_m3_v3

# --- Limits ---
DAILY_QUESTIONS_PER_USER=50
HOURLY_QUESTIONS_PER_USER=10
DAILY_TOKENS_GLOBAL=2000000
MAX_TOP_K=10
REQUEST_TIMEOUT_SEC=90
QUEUE_MAX_DEPTH=5

# --- Web UI (cookie sessions, invite-only) ---
WEB_ENABLED=true
# public domain for HTTPS (empty -> proxy profile is not started); bare domain, no scheme
WEB_DOMAIN=
WEB_COOKIE_SECURE=true
WEB_SESSION_TTL_DAYS=7
WEB_SESSION_IDLE_HOURS=24
WEB_AUTOMIGRATE=true
WEB_MAX_CONCURRENT_ASKS=4
WEB_LOGIN_IP_LIMIT=10
WEB_LOGIN_EMAIL_LIMIT=5
WEB_LOGIN_WINDOW_MIN=15
WEB_INVITE_TTL_DAYS=7
WEB_PASSWORD_MIN_LEN=12

# --- App ---
APP_VERSION=3.3.2
CORPUS_VERSION=2026.11.13-r2
DATA_SOURCE_DIR=/data/source
DATA_CORPUS_DIR=/data/corpus
DATA_KB_DIR=/data/kb
INDEX_DIR=/data/index
REPORTS_DIR=/app/reports
LOG_LEVEL=INFO
